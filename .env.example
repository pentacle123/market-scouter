# YouTube Data API v3 키 (Google Cloud Console → APIs & Services → Credentials)
# /api/youtube-scan 에서만 서버 사이드로 사용되므로 브라우저에 노출되지 않습니다.
YOUTUBE_API_KEY=your_youtube_api_key_here

# 네이버 데이터랩 (통합검색어 트렌드 + 쇼핑 인사이트) 자격증명
# 발급: https://developers.naver.com/apps → 애플리케이션 등록 → "데이터랩(검색어 트렌드)" 사용 API 추가
# /api/naver-trend 와 /api/naver-shopping 양쪽에서 동일한 자격증명을 사용합니다.
NAVER_CLIENT_ID=your_naver_client_id_here
NAVER_CLIENT_SECRET=your_naver_client_secret_here

# Anthropic Claude API 키 (Phase 3 AI 분석 엔진)
# 발급: https://console.anthropic.com/settings/keys
# /api/claude-analyze 에서만 서버 사이드로 사용됩니다.
ANTHROPIC_API_KEY=your_anthropic_api_key_here
